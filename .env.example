NVIDIA_API_KEY=nvapi-reemplaza-con-tu-clave
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_MAX_TOKENS=4096
NVIDIA_INPUT_CHARS=12000
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_RETRIES=8
NVIDIA_RETRY_MAX_WAIT_SECONDS=120
NVIDIA_RETRY_MAX_ELAPSED_SECONDS=900

# Límite global compartido por extracción y normalización de ubicaciones.
NVIDIA_RPM_LIMIT=40
# Se calcula automáticamente un mínimo seguro (1,55 s para 40 RPM).
NVIDIA_MIN_INTERVAL_SECONDS=0

# Pausa global tras varios timeouts; Retry-After tiene prioridad, incluso si supera max_wait.
NVIDIA_TIMEOUT_THRESHOLD=3
NVIDIA_TIMEOUT_COOLDOWN_SECONDS=60
# Checkpoints de una corrida interrumpida; las corridas terminadas comienzan una nueva revisión.
CHECKPOINT_MAX_AGE_HOURS=24
# Revalidación OCR para afiches que conservan la misma URL. No es un hash de imagen descargada.
OCR_CACHE_DAYS=30
# Opcional: ruta alternativa. Por defecto state/pipeline.sqlite3, persistida en Actions.
# PIPELINE_STATE_PATH=state/pipeline.sqlite3

# La IA solo revisa ubicaciones incompletas y las agrupa para ahorrar solicitudes.
NVIDIA_LOCATION_ENRICHMENT=true
NVIDIA_LOCATION_BATCH_SIZE=20
NVIDIA_LOCATION_MAX_BATCHES=5
NVIDIA_LOCATION_DESCRIPTION_CHARS=500
NVIDIA_LOCATION_TIMEOUT_SECONDS=60
NVIDIA_LOCATION_MAX_RETRIES=3
NVIDIA_LOCATION_RETRY_MAX_WAIT_SECONDS=30
NVIDIA_LOCATION_RETRY_MAX_ELAPSED_SECONDS=240
NVIDIA_CONTENT_ENRICHMENT=true
NVIDIA_REWRITE_ENABLED=true
NVIDIA_REWRITE_BATCH_SIZE=10
NVIDIA_REWRITE_INPUT_CHARS=3000
NVIDIA_REWRITE_TIMEOUT_SECONDS=90
NVIDIA_REWRITE_MAX_RETRIES=3
NVIDIA_REWRITE_RETRY_MAX_WAIT_SECONDS=60
NVIDIA_REWRITE_RETRY_MAX_ELAPSED_SECONDS=360
NVIDIA_OCR_ENABLED=true
NVIDIA_OCR_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_OCR_MAX_IMAGES=100
NVIDIA_OCR_TIMEOUT_SECONDS=45
NVIDIA_OCR_MAX_RETRIES=1
NVIDIA_OCR_RETRY_MAX_WAIT_SECONDS=15
NVIDIA_OCR_RETRY_MAX_ELAPSED_SECONDS=100

# Fuentes de dominios diferentes se procesan en paralelo. Cada dominio mantiene su pausa propia.
SOURCE_WORKERS=4
# Reutiliza respuestas públicas cuando el servidor confirma que no cambiaron (HTTP 304).
HTTP_CACHE_ENABLED=true
# Límite global para no almacenar descripciones HTML excesivamente grandes.
EVENT_DESCRIPTION_MAX_CHARS=8000
EVENT_OCR_MAX_CHARS=8000

# Carga remota opcional. Usa una clave secreta sb_secret_* únicamente en backend/CI.
SUPABASE_ENABLED=false
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_reemplaza_con_tu_clave
SUPABASE_BATCH_SIZE=200
SUPABASE_TIMEOUT_SECONDS=60
# Elimina eventos cuya fecha de término (o fecha única) ya quedó en el pasado.
SUPABASE_DELETE_EXPIRED=true
# Elimina por fuente las filas no vistas, solo tras extracciones exitosas y no vacías.
SUPABASE_RECONCILE_STALE=true
