{
  "name": "Centro Cultural La Moneda",
  "url": "https://www.cclm.cl/actividades-y-talleres/",
  "connector": "html_cards",
  "region": "Región Metropolitana de Santiago",
  "commune": "Santiago",
  "city": "Santiago",
  "organizer": "Centro Cultural La Moneda",
  "location_defaults": {
    "venue": "Centro Cultural La Moneda"
  },
  "default_categories": [
    "Cultura"
  ],
  "card_selector": "article.box--neo",
  "selectors": {
    "title": ".box__title a",
    "start_date": ".calendar",
    "start_time": ".box__info span:nth-of-type(1)",
    "venue": ".box__info span:nth-of-type(2)",
    "description": ".subtitulo",
    "image_url": {
      "selector": ".box__figure img",
      "attribute": "src"
    },
    "source_url": {
      "selector": ".box__title a",
      "attribute": "href"
    }
  },
  "max_results": 0,
  "official": true,
  "enabled": true
}
