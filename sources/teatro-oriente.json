{
  "name": "Teatro Oriente",
  "url": "https://teatrooriente.cl/cartelera-eventos/",
  "connector": "html_cards",
  "region": "Región Metropolitana de Santiago",
  "commune": "Providencia",
  "city": "Santiago",
  "organizer": "Fundación Cultural de Providencia",
  "venue": "Teatro Oriente",
  "address": "Avenida Pedro de Valdivia 099, Providencia",
  "default_categories": ["Cultura", "Artes escénicas"],
  "card_selector": ".upcoming-event-wrap .type-tribe_events",
  "exclude_card_pattern": "cancelado|suspendido|declarado Monumento nacional|Te invitamos a recorrer",
  "selectors": {
    "title": ".tribe-events-list-event-title a",
    "price": ".cost",
    "source_url": {"selector": ".tribe-events-list-event-title a", "attribute": "href"}
  },
  "detail_selectors": {
    "description": ".tribe-events-single-event-description"
  },
  "detail_jsonld_fields": ["start_date", "end_date", "image_url", "description", "price", "currency"],
  "detail_required_fields": ["start_date"],
  "require_start_date": true,
  "max_results": 0,
  "use_nvidia": false,
  "official": true,
  "enabled": true,
  "integration_status": "active",
  "integration_verified_at": "2026-10-27",
  "integration_note": "Cartelera HTML y fechas ISO con zona horaria del JSON-LD público de cada ficha. La API REST requiere autorización y no se utiliza. Excluye cancelaciones y avisos permanentes que no representan funciones."
}
